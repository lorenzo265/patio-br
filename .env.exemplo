# Copie para .env (o Git ignora o .env) e ajuste se precisar.
# Valores só do ambiente local: nunca use estes valores em homologação ou produção,
# e nunca coloque segredo real neste arquivo de exemplo.

# PostgreSQL de desenvolvimento e de testes (infra/docker-compose.yml)
POSTGRES_SENHA=patio-local
POSTGRES_PORTA=15432
POSTGRES_TESTE_PORTA=15433

# Nuvem (nuvem/src/nuvem/config.py). Se mudar a senha ou a porta acima, mude aqui também.
# Banco de desenvolvimento, usado por `uv run tarefas migrar` e pela API rodando fora do Docker.
PATIO_URL_BANCO=postgresql+pg8000://patio:patio-local@localhost:15432/patio
# Banco dos testes automáticos (o padrão é este mesmo endereço; o nome precisa terminar em _teste).
PATIO_URL_BANCO_TESTE=postgresql+pg8000://patio:patio-local@localhost:15433/patio_teste
# Chave que cifra os segredos guardados no banco (ex.: senha das câmeras). Esta é só do ambiente
# local; homologação e produção têm a própria, gerada com Fernet.generate_key() e guardada fora
# do repositório.
PATIO_CHAVE_CIFRA=_0_jqx-SW46BKdQoB9mZcMouVAft1Qjf8Pf2niPbThI=
# Onde a nuvem roda: local, homologacao ou producao. Só no local o cookie do login vai sem
# Secure (o ambiente local é http://localhost). Sem a variável, vale producao.
PATIO_AMBIENTE=local
# Endereço público da API, sem caminho, só atrás de um proxy HTTPS (homologação e produção): os
# endereços que a API devolve às caixas partem dele. No local, fica sem (vale o do pedido).
# PATIO_URL_PUBLICA=https://patio-br.example
# Pasta das fotos das passagens, no armazenamento local (dados/ fica fora do Git). No Docker, a
# API usa /app/dados/fotos, num volume.
PATIO_PASTA_FOTOS=dados/fotos

# Só na demonstração na Vercel (D-56; docs/guias/demonstracao-na-internet.md). No local, ficam
# todas de fora. Os valores de verdade vão nas variáveis de ambiente da Vercel, nunca aqui.
# PATIO_TIQUE=1                      # o trabalho do worker antes das telas que se atualizam
# PATIO_CABECALHO_DO_IP=x-real-ip    # o endereço de quem pede, que a Vercel escreve
# PATIO_BANCO_SEM_POOL=1             # quem guarda as conexões é o pooler do Supabase
# PATIO_BANCO_SSL=1                  # e PATIO_BANCO_CA com o certificado do Supabase, se pedir
# PATIO_FOTOS_S3_ENDERECO=https://<projeto>.storage.supabase.co/storage/v1/s3
# PATIO_FOTOS_S3_REGIAO=sa-east-1
# PATIO_FOTOS_S3_BALDE=fotos
# PATIO_FOTOS_S3_CHAVE=...           # as chaves S3 do Supabase (Storage → S3)
# PATIO_FOTOS_S3_SEGREDO=...
# CRON_SECRET=...                    # o segredo do cron diário da Vercel

# WhatsApp pela Cloud API da Meta (D-63; só na homologação e na produção, e nunca na
# demonstração). Sem elas, as mensagens ficam no canal de demonstração, sem enviar nada. Vão as
# cinco juntas; os valores de verdade ficam no cofre de segredos, nunca aqui.
# PATIO_WHATSAPP_TOKEN=...              # o token do usuário de sistema da Meta
# PATIO_WHATSAPP_NUMERO_ID=...          # o id do número do produto na Meta
# PATIO_WHATSAPP_NUMERO=55119...        # o número do produto, só números, com o 55
# PATIO_WHATSAPP_SEGREDO_DO_APP=...     # o segredo do app, que assina o webhook
# PATIO_WHATSAPP_CODIGO_DO_WEBHOOK=...  # o código escolhido ao cadastrar o webhook
# PATIO_WHATSAPP_VERSAO=v25.0

# SMS de reserva pela Zenvia (D-59 e D-64; também nunca na demonstração). Vão as três juntas. O
# segredo do retorno vai no endereço cadastrado na Zenvia (https://<domínio>/api/sms/<segredo>):
# gere um com `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# PATIO_SMS_TOKEN=...                   # o token da API da Zenvia
# PATIO_SMS_REMETENTE=...               # quem manda, na conta da Zenvia
# PATIO_SMS_SEGREDO_DO_WEBHOOK=...      # no mínimo 32 caracteres

# API da nuvem no docker (http://localhost:18000/saude)
API_PORTA=18000
