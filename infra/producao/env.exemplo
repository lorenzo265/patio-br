# O .env de /opt/patio em cada máquina (D-73). Copie para .env, troque cada TROQUE e feche:
#   chmod 600 .env
# Nada daqui vai para o Git com valor de verdade (regra 4 do CLAUDE.md).

# A versão da imagem: o deploy troca esta linha a cada versão.
VERSAO=TROQUE-pelo-deploy
DOMINIO=patio.exemplo.com.br

# O registro no CloudWatch (D-74): o compose.registros.yml entra por cima do compose.yml.
COMPOSE_FILE=compose.yml:compose.registros.yml
REGISTRO_GRUPO=patio-producao             # na homologação: patio-homologacao

# Na homologação: o PostgreSQL num contêiner (e a senha dele).
# COMPOSE_PROFILES=homologacao
# POSTGRES_SENHA=TROQUE-uma-senha-longa-sorteada

PATIO_AMBIENTE=producao                 # na homologação: homologacao
PATIO_URL_PUBLICA=https://patio.exemplo.com.br
PATIO_CABECALHO_DO_IP=X-Real-IP         # o Caddy escreve (Caddyfile)

# O banco: o RDS na produção (com SSL e o certificado da AWS); na homologação, o contêiner:
#   postgresql+pg8000://patio:<POSTGRES_SENHA>@postgres:5432/patio
PATIO_URL_BANCO=postgresql+pg8000://patio:TROQUE-a-senha@TROQUE-o-endereco-do-rds:5432/patio
PATIO_BANCO_SSL=1                       # na homologação, 0
# PATIO_BANCO_CA=TROQUE-o-conteudo-do-sa-east-1-bundle.pem

# A chave da cifra: nova, gerada uma vez e guardada no gerenciador de senhas (guia da produção).
PATIO_CHAVE_CIFRA=TROQUE-gere-uma-chave-nova

# As fotos no S3 (D-56), com o usuário do IAM só da nuvem.
PATIO_FOTOS_S3_ENDERECO=https://s3.sa-east-1.amazonaws.com
PATIO_FOTOS_S3_REGIAO=sa-east-1
PATIO_FOTOS_S3_BALDE=TROQUE-o-balde-das-fotos
PATIO_FOTOS_S3_CHAVE=TROQUE-a-chave-do-iam
PATIO_FOTOS_S3_SEGREDO=TROQUE-o-segredo-do-iam
# As âncoras da prova (D-69): só na produção, no balde com o Object Lock.
PATIO_ANCORAS_S3_BALDE=TROQUE-o-balde-das-ancoras
# As cópias do banco (D-74): um balde só delas, em cada ambiente.
PATIO_COPIAS_S3_BALDE=TROQUE-o-balde-das-copias

# O WhatsApp (D-63) e o SMS (D-64), quando as contas existirem.
# PATIO_WHATSAPP_TOKEN=TROQUE
# PATIO_WHATSAPP_NUMERO_ID=TROQUE
# PATIO_WHATSAPP_NUMERO=TROQUE
# PATIO_WHATSAPP_SEGREDO_DO_APP=TROQUE
# PATIO_WHATSAPP_CODIGO_DO_WEBHOOK=TROQUE
# PATIO_SMS_TOKEN=TROQUE
# PATIO_SMS_REMETENTE=TROQUE
# PATIO_SMS_SEGREDO_DO_WEBHOOK=TROQUE
